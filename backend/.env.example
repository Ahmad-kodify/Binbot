# Backend Environment Variables
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Connection URI (Optional: in-memory store used if not set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/binbot?retryWrites=true&w=majority

# AI Provider API Keys (Optional: grounded fallback used if not set)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
